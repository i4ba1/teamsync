# Database
DATABASE_URL=postgres://teamsync:teamsync_password@localhost:5432/teamsync_development

# Redis
REDIS_URL=redis://localhost:6379/0

# PASETO (generate with: openssl rand -base64 32)
PASETO_SECRET_KEY=your-secret-key-here-at-least-32-bytes-long-change-in-production

# Rails
SECRET_KEY_BASE=your-rails-secret-key-here
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true

# Action Cable
ACTION_CABLE_ALLOWED_REQUEST_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL (for CORS and emails)
FRONTEND_URL=http://localhost:3000
