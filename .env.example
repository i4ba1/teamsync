# Copy to .env before running `docker compose up`.

# Signs PASETO access tokens. Generate with: openssl rand -base64 32
PASETO_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32

# Rails secret key base. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=change-me-generate-with-openssl-rand-hex-64

# Contents of backend/config/master.key (used to decrypt credentials.yml.enc).
# Generate once with: openssl rand -hex 16
RAILS_MASTER_KEY=change-me-32-hex-characters
